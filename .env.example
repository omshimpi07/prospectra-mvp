# Prospectra environment template
# Copy this file to `.env` and fill in your own values.
# Never commit `.env` or real credentials. Values below are placeholders only.

# --- Application ---

# Runtime environment name, e.g. development, staging, production.
ENVIRONMENT=development

# Enables debug behavior in the backend (true/false). Keep false outside local development.
DEBUG=false

# --- Database ---

# Async PostgreSQL connection string used by the backend (SQLAlchemy + psycopg 3).
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE

# --- CORS ---

# Origins the backend allows to call its API (the frontend URL), comma-separated.
CORS_ORIGINS=http://localhost:3000

# --- Supabase ---

# Base URL of your Supabase project.
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon (public) key. Intended for client-facing use and relies on
# Row Level Security for protection.
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service-role key. BACKEND ONLY.
# This key bypasses Row Level Security. Keep it on the server, never send it
# to the browser, and never give it a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Gemini ---

# Google Gemini API key, read by the backend only.
GEMINI_API_KEY=your-gemini-api-key

# --- AI Provider (OpenRouter Free-First Architecture) ---

# AI Gateway provider: 'openrouter' or 'mock'
AI_PROVIDER=openrouter

# AI model slug (configurable, default: 'openrouter/free')
AI_MODEL=openrouter/free

# OpenRouter API Key. BACKEND ONLY.
# Get free key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key

# Optional attribution headers for OpenRouter rankings (omit or customize)
# OPENROUTER_HTTP_REFERER=
# OPENROUTER_TITLE=

# --- Search & Discovery (Sprint 3 Overture + DuckDB Architecture) ---

# Discovery Provider: 'overture' or 'mock'
DISCOVERY_PROVIDER=overture

# Optional pinned Overture release (leave unset to dynamically resolve via STAC catalog)
# OVERTURE_RELEASE=2026-09-23.1
